# Public values only: node-api validates JWTs with Logto's public JWKS, it holds no secret.
# Copy to `.env` (ignored by git). In Docker, inject it with `env_file:` instead of baking it into the image.
PORT=8081

# Tolerance used to decide whether a matrix is diagonal.
DIAGONAL_TOLERANCE=1e-9

# Logto tenant endpoint (origin only, no trailing slash). Derived: issuer = <endpoint>/oidc, JWKS = <endpoint>/oidc/jwks
LOGTO_ENDPOINT=https://00rojz.logto.app
# Application id of the SPA in Logto: the `aud` of the ID tokens accepted as Bearer tokens.
LOGTO_APP_ID=al1l6ebtq85itt3ya6cmg

# Allowed browser origins, comma-separated (no wildcard).
CORS_ORIGINS=http://localhost:5173
