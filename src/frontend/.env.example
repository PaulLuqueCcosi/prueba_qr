# Public values only: the SPA is a public client (Authorization Code + PKCE), there is no secret.
# Logto tenant endpoint (origin only).
VITE_LOGTO_ENDPOINT=https://00rojz.logto.app
# Application ID of the Logto "Single page app" (Matrix Frontend). Its ID token is the Bearer token
# for both APIs (no API resource: Logto's Free plan has none), so go-api/node-api use this id as LOGTO_APP_ID.
# Redirect URI: http://localhost:5173/callback - Post sign-out redirect URI: http://localhost:5173
VITE_LOGTO_APP_ID=al1l6ebtq85itt3ya6cmg
VITE_GO_API_URL=http://localhost:8080
VITE_NODE_API_URL=http://localhost:8081
