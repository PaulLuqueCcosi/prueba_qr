# Public values only: go-api validates JWTs with Auth0's public JWKS, it holds no secret.
# Copy to `.env` (ignored by git). In Docker, inject it with `env_file:` instead of baking it into the image.
PORT=8080

# Base URL of node-api. In docker-compose use http://node-api:8081, never localhost.
NODE_API_URL=http://localhost:8081
NODE_API_TIMEOUT_MS=5000

# Auth0 tenant hostname only (no scheme, no trailing slash). The issuer is derived as https://<domain>/
AUTH0_DOMAIN=dev-qcn2z3c16k25ecd1.us.auth0.com
AUTH0_AUDIENCE=https://api.matrix-challenge.dev

# Allowed browser origins, comma-separated (no wildcard).
CORS_ORIGINS=http://localhost:5173
