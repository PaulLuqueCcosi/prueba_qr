{
  "info": {
    "name": "node-api",
    "description": "Automated tests for node-api (statistics service). Run with newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('responds with JSON', () => pm.response.to.be.json);",
              "const json = pm.response.json();",
              "pm.test('body is as expected', () => {",
              "  pm.expect(json.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{nodeApiUrl}}/health",
          "host": [
            "{{nodeApiUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "02 Valid 2x2 (q diagonal)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('responds with JSON', () => pm.response.to.be.json);",
              "const json = pm.response.json();",
              "pm.test('body is as expected', () => {",
              "  pm.expect(json.max).to.eql(7);",
              "  pm.expect(json.min).to.eql(0);",
              "  pm.expect(json.average).to.be.closeTo(2.5, 1e-9);",
              "  pm.expect(json.sum).to.be.closeTo(30, 1e-9);",
              "  pm.expect(json.isDiagonal).to.eql({\"original\":false,\"q\":true,\"r\":false});",
              "  pm.expect(json.anyDiagonal).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"matrices\": {\n    \"original\": [\n      [\n        1,\n        2\n      ],\n      [\n        3,\n        4\n      ]\n    ],\n    \"q\": [\n      [\n        1,\n        0\n      ],\n      [\n        0,\n        1\n      ]\n    ],\n    \"r\": [\n      [\n        5,\n        6\n      ],\n      [\n        0,\n        7\n      ]\n    ]\n  }\n}"
        },
        "url": {
