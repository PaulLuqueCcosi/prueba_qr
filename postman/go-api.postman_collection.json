{
  "info": {
    "name": "go-api",
    "description": "End-to-end tests for go-api (go-api -> node-api). Both services must be running. Run with newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('responds with JSON', () => pm.response.to.be.json);",
              "pm.test(\"body is as expected\", () => pm.expect(pm.response.json()).to.eql({ status: \"ok\" }));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{goApiUrl}}/health",
          "host": [
            "{{goApiUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "02 Classic 3x3",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('responds with JSON', () => pm.response.to.be.json);",
              "const T = 1e-9;",
              "const json = pm.response.json();",
              "const A = [[12,-51,4],[6,167,-68],[-4,24,-41]];",
              "const m = A.length, n = A[0].length;",
              "const dims = (x) => [x.length, x[0].length];",
              "const mul = (X, Y) => X.map((r, i) => Y[0].map((_, j) => r.reduce((s, v, k) => s + v * Y[k][j], 0)));",
              "const tr = (X) => X[0].map((_, j) => X.map((r) => r[j]));",
              "pm.test('original echoes the input', () => pm.expect(json.original).to.eql(A));",
              "pm.test('q is m x m and r is m x n', () => {",
              "  pm.expect(dims(json.q)).to.eql([m, m]);",
              "  pm.expect(dims(json.r)).to.eql([m, n]);",
              "});",
              "pm.test('r is upper trapezoidal', () => {",
              "  json.r.forEach((row, i) => row.forEach((v, j) => { if (i > j) pm.expect(Math.abs(v)).to.be.at.most(T); }));",
              "});",
              "pm.test('Q * R reconstructs original', () => {",
              "  const P = mul(json.q, json.r);",
              "  P.forEach((row, i) => row.forEach((v, j) => pm.expect(Math.abs(v - A[i][j])).to.be.at.most(T)));",
              "});",
              "pm.test('Q^T * Q is the identity', () => {",
              "  const P = mul(tr(json.q), json.q);",
              "  P.forEach((row, i) => row.forEach((v, j) => pm.expect(Math.abs(v - (i === j ? 1 : 0))).to.be.at.most(T)));",
              "});",
              "pm.test('statistics are consistent with original, q and r', () => {",
              "  const all = [].concat(...json.original, ...json.q, ...json.r);",
              "  const sum = all.reduce((s, v) => s + v, 0);",
              "  const s = json.statistics;",
              "  pm.expect(s).to.have.all.keys('max', 'min', 'average', 'sum', 'isDiagonal', 'anyDiagonal');",
              "  pm.expect(s.max).to.be.closeTo(Math.max(...all), T);",
              "  pm.expect(s.min).to.be.closeTo(Math.min(...all), T);",
              "  pm.expect(s.sum).to.be.closeTo(sum, T);",
              "  pm.expect(s.average).to.be.closeTo(sum / all.length, T);",
              "  pm.expect(s.isDiagonal).to.have.all.keys('original', 'q', 'r');",
              "  pm.expect(s.anyDiagonal).to.be.a('boolean');",
              "});",
              "pm.test('|diag(r)| is 14, 175, 35', () => {",
              "  [14, 175, 35].forEach((d, i) => pm.expect(Math.abs(json.r[i][i])).to.be.closeTo(d, 1e-9));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"matrix\": [\n    [\n      12,\n      -51,\n      4\n    ],\n    [\n      6,\n      167,\n      -68\n    ],\n    [\n      -4,\n      24,\n      -41\n    ]\n  ]\n}"
        },
        "url": {
          "raw": "{{goApiUrl}}/api/v1/qr",
          "host": [
            "{{goApiUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "qr"
          ]
        }
      }
    },
